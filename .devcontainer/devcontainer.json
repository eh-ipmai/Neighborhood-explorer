{
  "name": "Neighborhood Explorer RPG",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": {
      "label": "Game Preview (Vite)",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": {
    "npm": "npm install",
    "agy": "[ -x \"$HOME/.local/bin/agy\" ] || command -v agy >/dev/null 2>&1 || curl -fsSL https://antigravity.google/cli/install.sh | bash"
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/node/.local/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
